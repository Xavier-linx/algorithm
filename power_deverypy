import sys
import math
import heapq

n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))

b = sorted(b, reverse=True)
heap = []
for v in a:
    heapq.heappush(heap, (v, 1, v))
k = [1 for _ in range(n+1)]

res = 0

for bi in b:
    value, stones, source = heapq.heappop(heap)
    if value >= bi:
        break
    res += (bi - value)

    value = source * (stones+1)
    heapq.heappush(heap, (value, stones+1, source))

print(res)
            
